{
  "info": {
    "_postman_id": "pico-rover-api",
    "name": "Pico Rover API",
    "description": "Complete API collection for Pico W Rover testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "🔌 Connection & Status",
      "item": [
        {
          "name": "Server Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Get basic server status (online/offline)"
          },
          "response": []
        },
        {
          "name": "Get Rover Telemetry",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/status",
              "host": ["{{base_url}}"],
              "path": ["status"]
            },
            "description": "Get detailed rover status: battery, uptime, motor speeds, latency"
          },
          "response": []
        }
      ]
    },
    {
      "name": "🚗 Motor Control",
      "item": [
        {
          "name": "Move Forward (100%)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"a\": 100,\n  \"b\": 100\n}"
            },
            "url": {
              "raw": "{{base_url}}/motor",
              "host": ["{{base_url}}"],
              "path": ["motor"]
            },
            "description": "Full speed forward"
          },
          "response": []
        },
        {
          "name": "Move Forward (50%)",
          "request": {
            "method": "POST",
            "header": [
