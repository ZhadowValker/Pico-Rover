        {
          "name": "Emergency Stop",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/motor/stop",
              "host": ["{{base_url}}"],
              "path": ["motor", "stop"]
            },
            "description": "Immediately stop all motors (emergency stop)"
          },
          "response": []
