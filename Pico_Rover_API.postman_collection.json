    {
      "name": "📡 WiFi Management",
      "item": [
        {
          "name": "Scan WiFi Networks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/scan",
              "host": ["{{base_url}}"],
              "path": ["api", "scan"]
            },
            "description": "Scan for available WiFi networks (SSID, RSSI, channel, security)"
          },
          "response": []
        },
        {
          "name": "Connect to WiFi (Template)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ssid\": \"MyNetwork\",\n  \"password\": \"mypassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/connect",
              "host": ["{{base_url}}"],
              "path": ["api", "connect"]
            },
            "description": "Connect Pico to a WiFi network (update ssid and password)"
          },
          "response": []
        }
      ]
    }
